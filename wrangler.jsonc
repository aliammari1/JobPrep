{
  // Cloudflare Workers config for deploying JobPrep via @opennextjs/cloudflare.
  //
  // Architecture:
  //  - Compute: Cloudflare Workers (Smart Placement + nodejs_compat)
  //  - Static Assets: Workers Assets binding (.open-next/assets)
  //  - Next.js ISR / Data Cache: R2 (`NEXT_INC_CACHE_R2_BUCKET`)
  //  - Recordings Storage: R2 (`RECORDINGS_BUCKET`) + 15m Cron cleanup
  //  - Database: PostgreSQL via Cloudflare Hyperdrive (`HYPERDRIVE`)
  //  - Images: Cloudflare Images (`/cdn-cgi/image` loader + `IMAGES` binding)
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobprep",
  "main": "cloudflare-worker.mjs",
  "compatibility_date": "2026-11-19",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "upload_source_maps": true,
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Required by @opennextjs/cloudflare for internal ISR & revalidation loopbacks
      "binding": "WORKER_SELF_REFERENCE",
      "service": "jobprep"
    }
  ],
  "r2_buckets": [
    {
      "binding": "RECORDINGS_BUCKET",
      "bucket_name": "jobprep-recordings"
    },
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "jobprep-next-cache"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "triggers": {
    "crons": ["*/15 * * * *"]
  },
  "hyperdrive": [
    {
      // Replace `id` with the ID from `wrangler hyperdrive create jobprep-db --connection-string="$DATABASE_URL" --caching-disabled`
      // before production deploy. Locally & in CI, `localConnectionString` (or
      // `CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE`) emulates Hyperdrive via Miniflare.
      "binding": "HYPERDRIVE",
      "id": "00000000000000000000000000000000",
      "localConnectionString": "postgresql://jobprep:jobprep@127.0.0.1:5432/jobprep"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
  // Optional native Workers Rate Limiting (zero external Redis round-trips):
  // "ratelimits": [
  //   { "name": "AI_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
  //   { "name": "LIVEKIT_RATE_LIMITER", "namespace_id": "1002", "simple": { "limit": 10, "period": 60 } },
  //   { "name": "DEFAULT_RATE_LIMITER", "namespace_id": "1003", "simple": { "limit": 60, "period": 60 } }
  // ]
}
