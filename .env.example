# =============================================================================
# JobPrep environment configuration
# Copy this file to `.env` and fill in values. For a local build only, set
# SKIP_ENV_VALIDATION=1 and placeholder values are accepted (see CI).
# =============================================================================

# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# PostgreSQL connection string (Prisma). Use a managed Postgres in production
# (Neon/Supabase) and Cloudflare Hyperdrive at the edge — see docs/DEPLOYMENT.md.
DATABASE_URL=
# Pooled URL used by Prisma in serverless environments (optional but recommended).
POSTGRES_PRISMA_URL=

# Better Auth (https://www.better-auth.com)
BETTER_AUTH_SECRET=          # generate: `openssl rand -base64 32`
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_NAME=JobPrep

# ---------------------------------------------------------------------------
# AI PROVIDERS (configure at least one; the AI Coach picks per request)
#   Default model: claude-haiku-4-5 (override with AI_COACH_DEFAULT_MODEL)
# ---------------------------------------------------------------------------
AI_COACH_DEFAULT_MODEL=anthropic:claude-haiku-4-5

# Anthropic / Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI / GPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_BASE_URL=             # optional; for OpenAI-compatible gateways
OPENAI_MODEL=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Ollama (local or hosted) — https://ollama.com
OLLAMA_HOST=                 # e.g. http://localhost:11434/v1
OLLAMA_API_KEY=              # only for hosted ollama.com
OLLAMA_MODEL=llama3.2:latest

# ---------------------------------------------------------------------------
# OPTIONAL — Billing (Stripe). Without these, billing features are disabled.
#   https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# OPTIONAL — Live video interviews (LiveKit + Simli / HeyGen avatar)
#   LiveKit:  https://cloud.livekit.io
#   Simli:    https://www.simli.com
#   HeyGen:   https://www.heygen.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LIVEKIT_URL=     # wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
SIMLI_API_KEY=
NEXT_PUBLIC_SIMLI_API_KEY=
SIMLI_FACE_ID=
NEXT_PUBLIC_SIMLI_FACE_ID=
HEYGEN_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — Code execution (coding arena)
#   Judge0: https://rapidapi.com/judge0-official/api/judge0-ce
#   Piston (free, no key): https://github.com/engineer-man/piston
# ---------------------------------------------------------------------------
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
USE_RAPID_API=true
# PISTON_API_URL=https://emkc.org/api/v2/piston

# ---------------------------------------------------------------------------
# OPTIONAL — Email (Gmail SMTP or Resend)
# ---------------------------------------------------------------------------
GMAIL_USER_EMAIL=
GMAIL_APP_PASSWORD=          # https://myaccount.google.com/apppasswords
RESEND_API_KEY=             # https://resend.com/api-keys
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# OPTIONAL — Rate limiting (Upstash Redis). Without these, limits are a no-op.
#   https://upstash.com  → Redis → REST API
#   Protects the paid AI + LiveKit endpoints from abuse.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL — Observability (Sentry + OpenTelemetry). All no-ops if unset.
#   https://sentry.io  — error tracking + AI token/cost tracing
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=           # only needed to upload source maps at build time

# ---------------------------------------------------------------------------
# OPTIONAL — Google / LinkedIn integrations & Appwrite
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_PROJECT_NAME=
NEXT_PUBLIC_APPWRITE_ENDPOINT=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=
