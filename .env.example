# =============================================================================
# JobPrep environment configuration
# Copy this file to `.env` and fill in values. The app validates required
# values at startup; CI uses schema-valid placeholder values.
# =============================================================================

# ---------------------------------------------------------------------------
# CORE / DATABASE — server-only, required
# ---------------------------------------------------------------------------

# Local PostgreSQL URL for docker-compose.yml. Replace it if using your own
# PostgreSQL instance. See docs/DEPLOYMENT.md for production configuration.
DATABASE_URL=postgresql://jobprep:jobprep@127.0.0.1:5432/jobprep
# Pooled URL used by Prisma in serverless environments (optional but recommended).
POSTGRES_PRISMA_URL=

# AUTH — server-only unless marked NEXT_PUBLIC, required
# Generate a local secret with `openssl rand -base64 32`.
BETTER_AUTH_SECRET=
# REQUIRED in production. OMIT in local dev: Better Auth then derives its base
# URL per request, so verification links and origin checks automatically match
# whatever port `bun run dev` serves (which shifts when 3000 is taken).
# BETTER_AUTH_URL=https://your-app.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Show the "Continue with Google" button. Only set true when GOOGLE_CLIENT_ID
# / GOOGLE_CLIENT_SECRET are configured (server enables Google only then).
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
APP_NAME=JobPrep

# ---------------------------------------------------------------------------
# AI PROVIDERS (optional for setup; configure one to try AI features)
#   Default model: claude-haiku-4-5 (override with AI_COACH_DEFAULT_MODEL)
# ---------------------------------------------------------------------------
AI_COACH_DEFAULT_MODEL=anthropic:claude-haiku-4-5

# Anthropic / Claude — https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# OpenAI / GPT — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_BASE_URL=             # optional; for OpenAI-compatible gateways
OPENAI_MODEL=

# Google Gemini — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter (free `:free` models & multi-provider routing) — https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional Cloudflare AI Gateway URL & remote model manifest
# CF_AI_GATEWAY_URL=https://gateway.ai.cloudflare.com/v1/<account>/<gateway>/compat
# MODEL_MANIFEST_URL=

# Ollama (local or hosted) — https://ollama.com
OLLAMA_HOST=                 # e.g. http://localhost:11434/v1
OLLAMA_API_KEY=              # only for hosted ollama.com
OLLAMA_MODEL=llama3.2:latest

# ---------------------------------------------------------------------------
# OPTIONAL — Billing (Stripe). Without these, billing features are disabled.
#   https://dashboard.stripe.com/apikeys
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PRICE_MONTHLY=
NEXT_PUBLIC_STRIPE_PRICE_YEARLY=

# ---------------------------------------------------------------------------
# OPTIONAL — Live video interviews (LiveKit and optional HeyGen avatar)
#   LiveKit:  https://cloud.livekit.io
#   HeyGen:   https://www.heygen.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_LIVEKIT_URL=     # wss://your-project.livekit.cloud
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
HEYGEN_API_KEY=

# ---------------------------------------------------------------------------
# OPTIONAL — Code execution (coding arena)
#   Daytona: https://app.daytona.io
#   Judge0:  https://rapidapi.com/judge0-official/api/judge0-ce
#   Piston (free, no key): https://github.com/engineer-man/piston
# ---------------------------------------------------------------------------
DAYTONA_API_KEY=
# DAYTONA_API_URL=https://app.daytona.io/api
# DAYTONA_SNAPSHOT=             # snapshot with Node.js 22.18+, Python 3, Go, GCC, and a JDK
JUDGE0_API_URL=https://judge0-ce.p.rapidapi.com
JUDGE0_API_KEY=
USE_RAPID_API=true
# PISTON_API_URL=https://emkc.org/api/v2/piston

# ---------------------------------------------------------------------------
# OPTIONAL — Email (Gmail SMTP or Resend)
# ---------------------------------------------------------------------------
GMAIL_USER_EMAIL=
GMAIL_APP_PASSWORD=          # https://myaccount.google.com/apppasswords
RESEND_API_KEY=             # https://resend.com/api-keys
RESEND_FROM_EMAIL=

# ---------------------------------------------------------------------------
# OPTIONAL — Rate limiting (Upstash Redis fallback for local or self-hosted apps)
#   https://upstash.com  → Redis → REST API
#   Used by AI, LiveKit, and code execution when no Cloudflare limiter is bound.
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# OPTIONAL — Observability & Analytics (Sentry + PostHog). All no-ops if unset.
#   https://sentry.io   — error tracking + AI token/cost tracing
#   https://posthog.com — anonymous pageviews, configured at build time
# ---------------------------------------------------------------------------
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=           # only needed to upload source maps at build time
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ---------------------------------------------------------------------------
# OPTIONAL — Google / LinkedIn integrations (server-only)
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/integrations/linkedin/callback

# ---------------------------------------------------------------------------
# OPTIONAL — Web Push (server-only; planned, sender not implemented yet)
#   Generate with: `bunx web-push generate-vapid-keys`
#   POST /api/notifications/send validates input but returns 501 until a
#   `web-push` sender + persistent subscription store are wired.
# ---------------------------------------------------------------------------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# ---------------------------------------------------------------------------
# OPTIONAL — Cloudflare / storage (server-only; bind resources in wrangler)
# ---------------------------------------------------------------------------
# HYPERDRIVE is a Workers binding, not a secret environment variable.
