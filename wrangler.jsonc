{
  // Cloudflare Workers config for deploying JobPrep via @opennextjs/cloudflare.
  //
  // Database: JobPrep uses Prisma 7 + PostgreSQL (Better Auth relational schema).
  // Connect managed Postgres through Cloudflare **Hyperdrive** for global
  // connection pooling & edge query caching (see docs/DEPLOYMENT.md).
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jobprep",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Uncomment once created via `wrangler hyperdrive create jobprep-db --connection-string="..."`:
  // "hyperdrive": [
  //   { "binding": "HYPERDRIVE", "id": "<hyperdrive-id>" }
  // ],
  //
  // Uncomment once created via `wrangler r2 bucket create jobprep-recordings`:
  // "r2_buckets": [
  //   { "binding": "RECORDINGS_BUCKET", "bucket_name": "jobprep-recordings" }
  // ]
}
